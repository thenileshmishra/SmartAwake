{
  "manifest_version": 3,
  "name": "SmartAwake",
  "version": "1.0",
  "description": "Prevents your system or display from sleeping.",
  "permissions": ["power", "storage", "tabs", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
